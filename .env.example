# ==========================================
# KONFIGURASI BOT WHATSAPP GRUP SALAF
# ==========================================

# 1. Kunci Gemini API (Dapatkan percuma di https://aistudio.google.com/)
GEMINI_API_KEY=masukkan_api_key_anda_di_sini

# 2. Model Gemini (Pilihan: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# 3. Tetapan Bot
BOT_NAME="Bot Rujukan Salaf"
BOT_PREFIX="!"

# 4. Kaedah Sambungan WhatsApp (Pairing Code atau QR Code)
USE_PAIRING_CODE=true
BOT_PHONE_NUMBER=601157496471

# 5. Mod Respons:
BOT_MODE=mention_or_prefix

# 6. Respon Dalam Chat Peribadi (PM/DM)
RESPOND_IN_PRIVATE=false

# 7. ID Grup WhatsApp untuk Auto Faedah Harian (Boleh letak banyak grup dipisahkan koma)
# Contoh format: id1@g.us,id2@g.us,id3@g.us
TARGET_GROUP_JID=
