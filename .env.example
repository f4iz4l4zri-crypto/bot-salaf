# ==========================================
# KONFIGURASI BOT WHATSAPP GRUP SALAF
# ==========================================

# 1. Kunci Gemini API (Dapatkan percuma di https://aistudio.google.com/)
GEMINI_API_KEY=masukkan_api_key_anda_di_sini

# 2. Model Gemini (Pilihan: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# 3. Tetapan Bot
BOT_NAME="Bot Rujukan Salaf"
BOT_PREFIX="!"

# 4. Mod Respons:
# 'mention_or_prefix' : Balas bila ada arahan (!tanya, !dalil) ATAU tag @Bot ATAU reply mesej bot
# 'all' : Balas semua mesej yang ada soalan (tidak disyorkan untuk grup ramai ahli)
BOT_MODE=mention_or_prefix

# 5. ID Grup WhatsApp untuk Auto Faedah Harian (Pilihan: tinggalkan kosong dahulu)
# Contoh format: 1203630xxxxxxxxxx@g.us
TARGET_GROUP_JID=
